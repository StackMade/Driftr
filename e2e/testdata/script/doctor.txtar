# doctor reports on the install, and --fix repairs what it can.

exec driftr setup
exec driftr install node@22
exec driftr default node@$NODE_VERSION

exec driftr doctor
stdout 'PATH'

exec driftr doctor --fix

rm $HOME/.driftr/bin/node$exe
exec driftr doctor
stdout 'Shim broken or missing: node'
! exists $HOME/.driftr/bin/node$exe

exec driftr doctor --fix
stdout 'regenerated'
exists $HOME/.driftr/bin/node$exe
exec node -v
stdout 'v'$NODE_VERSION

# Windows has no execute bit to lose.
[!windows] chmod 0644 $HOME/.driftr/bin/npm
[!windows] exec driftr doctor --fix
[!windows] stdout 'regenerated'
exec npm -v
stdout '10\.99\.0'

exec driftr doctor --fix
stdout 'All 7 shims installed'
