# list --remote reads the same upstream feeds as install.

exec driftr setup

exec driftr list --remote node
stdout 'Available node versions \(latest 1 of 1\):'
stdout $NODE_VERSION' \(LTS: Fixture\)'

exec driftr list --remote npm
stdout 'Available npm versions \(latest 1 of 1\):'
stdout $NPM_VERSION

exec driftr list --remote pnpm
stdout 'Available pnpm versions \(latest 1 of 1\):'
stdout $PNPM_VERSION

exec driftr list --remote bun
stdout 'Available bun versions \(latest 1 of 1\):'
stdout $BUN_VERSION

exec driftr install node@$NODE_VERSION
exec driftr default node@$NODE_VERSION
exec driftr list --remote node
stdout '>\*● '$NODE_VERSION
stdout '= global default'

! exec driftr list --remote deno
stderr 'unknown tool: deno'
