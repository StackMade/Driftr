# Without the project registry, pruning from b would delete the only node, which a pins.

exec driftr setup
exec driftr install node@22

# No global default and nothing pinned outside a, so a alone keeps this version.
cd $WORK/a
exec driftr pin node@$NODE_VERSION
grep $WORK/a $HOME/.driftr/config/projects

# Installing from a project's pins records it too.
cd $WORK/c
exec driftr install
grep $WORK/c $HOME/.driftr/config/projects

# Pruning from an unrelated directory keeps what a pins.
cd $WORK/b
exec driftr prune --dry-run
stdout 'Checked 2 recorded project'
stdout $WORK/a
exec driftr prune -y
stdout 'Nothing to prune'
exec driftr list
stdout $NODE_VERSION

# A deleted recorded project is forgotten and no longer protects anything.
rm $WORK/a
rm $WORK/c
exec driftr prune --dry-run
stdout 'would be forgotten'
grep $WORK/a $HOME/.driftr/config/projects
exec driftr prune -y
stdout 'Forgot 2 recorded project'
! grep $WORK/a $HOME/.driftr/config/projects
exec driftr list
! stdout $NODE_VERSION

# Without -y prune asks first, and only a yes removes anything.
exec driftr install node@22
stdin $WORK/no.txt
exec driftr prune
stdout 'Remove 1 version\(s\)\?'
stdout 'Aborted, nothing was removed'
exec driftr list
stdout $NODE_VERSION
stdin $WORK/yes.txt
exec driftr prune
stdout 'Removed 1 version\(s\)'
exec driftr list
! stdout $NODE_VERSION

! exec driftr prune --tool deno
stderr 'unknown tool: deno'

-- no.txt --
n
-- yes.txt --
y
-- a/README.md --
placeholder so the directory exists
-- b/README.md --
placeholder so the directory exists
-- c/.nvmrc --
22.99.0
