# auto_install is the only path that installs what the user did not name, so pin it end to end.

exec driftr setup

# stdin is not a terminal here, so driftr must fail outright instead of prompting.
cd $WORK/project
! exec node -v
stderr 'is not installed'
stderr 'driftr install node@'$NODE_VERSION
! exists $HOME/.driftr/tools/node/$NODE_VERSION/bin/node

cd $WORK
exec driftr setup
cp autoinstall.toml $HOME/.driftr/config/config.toml

cd $WORK/project
exec node -v
stderr 'Installing node@'$NODE_VERSION
stderr 'Installed node '$NODE_VERSION
stdout 'v'$NODE_VERSION
exists $HOME/.driftr/tools/node/$NODE_VERSION/bin/node

# The shim path never records the project for prune: tool calls must stay write-free.
! exists $HOME/.driftr/config/projects

exec node -v
stdout 'v'$NODE_VERSION
! stderr 'Installing'

# A version missing upstream fails with the install error rather than looping or succeeding.
cd $WORK/missing
! exec node -v
stderr 'auto-install failed|not installed'

-- project/.driftr.toml --
[tools]
node = "22.99.0"

-- missing/.driftr.toml --
[tools]
node = "1.2.3"

-- autoinstall.toml --
auto_install = true
