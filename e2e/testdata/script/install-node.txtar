# Installing node: download, checksum verification, and the global default.

exec driftr setup

exec driftr install node@22 -v
stdout 'Checksum verified OK'
exists $HOME/.driftr/tools/node/$NODE_VERSION/bin/node

exec driftr list
stdout $NODE_VERSION

exec driftr default node@$NODE_VERSION
exec driftr list
stdout '\*'

exec driftr which node
stdout $NODE_VERSION
stdout 'global default'

# A partial spec resolves against what is already installed.
exec driftr default node@22
exec driftr which node
stdout $NODE_VERSION

# Reinstalling the same version is a no-op, not an error.
exec driftr install node@$NODE_VERSION
exec driftr list
stdout $NODE_VERSION

# The fixture node prints its own version.
exec node -v
stdout 'v'$NODE_VERSION

exec npm -v
stdout '10\.99\.0'

# A partial .nvmrc pin runs the newest installed match through the shim and in which.
mkdir $WORK/partial
cd $WORK/partial
cp $WORK/nvmrc-22 .nvmrc
exec node -v
stdout 'v'$NODE_VERSION
exec driftr which node
stdout $NODE_VERSION
stdout '\.nvmrc'
cd $WORK

# lts resolves through the release index, which marks the fixture as LTS.
exec driftr install node@lts -v
stdout 'Installed|already installed'

# No other tool has an LTS concept.
! exec driftr install pnpm@lts
stderr 'lts is only supported for node'
! exec driftr install yarn@lts
stderr 'lts is only supported for node'
! exec driftr install bun@lts
stderr 'lts is only supported for node'

# A bare install takes every project pin; one failing tool does not stop the others.
cd $WORK/pins
! exec driftr install
stdout 'Installed node '$NODE_VERSION
stdout 'Failed to install pnpm 8\.0\.0'
stderr '1 of 2 pinned tools failed'
! exists $HOME/.driftr/tools/pnpm/8.0.0
cd $WORK

# Outside any project there is nothing to install, and the error says how to pin.
mkdir $WORK/empty
cd $WORK/empty
! exec driftr install
stderr 'no tool versions pinned'
stderr 'driftr pin node@'
cd $WORK

-- pins/.driftr.toml --
[tools]
node = "22"
pnpm = "8.0.0"
-- nvmrc-22 --
22
