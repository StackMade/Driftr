# Package bins get shims, run under the node that installed them, and go with that node.

[windows] skip 'hand-made node versions are sh scripts; see package-bins-windows.txtar'

exec driftr setup
exec driftr install node@22
exec driftr default node@$NODE_VERSION

# The fixture serves one node release, so this second node is laid out by hand like npm -g.
mkdir $HOME/.driftr/tools/node/20.0.0/bin
cp node20 $HOME/.driftr/tools/node/20.0.0/bin/node
cp hello $HOME/.driftr/tools/node/20.0.0/bin/hello
chmod 0755 $HOME/.driftr/tools/node/20.0.0/bin/node
chmod 0755 $HOME/.driftr/tools/node/20.0.0/bin/hello

# No shim yet: nothing has refreshed them since the bin appeared.
! exists $HOME/.driftr/bin/hello

# npm -g refreshes the shims once npm exits, keeping npm's exit code.
exec npm install -g hello
stdout '10.99.0'
exists $HOME/.driftr/bin/hello

# hello runs under node 20, the one it was installed with, not the default.
exec hello
stdout 'hello under v20.0.0'

exec driftr which hello
stdout 'global npm package'
stdout '20\.0\.0'

# A bin named like a file driftr did not write keeps that file, and npm -g says why.
cp hello $HOME/.driftr/tools/node/20.0.0/bin/greet
chmod 0755 $HOME/.driftr/tools/node/20.0.0/bin/greet
cp mine $HOME/.driftr/bin/greet
exec npm install -g greet
stderr 'no shim for greet: .* is not a driftr shim'
grep 'my own greet' $HOME/.driftr/bin/greet

exec driftr uninstall node@20.0.0
! exists $HOME/.driftr/bin/hello
exists $HOME/.driftr/bin/node

-- node20 --
#!/bin/sh
echo "v20.0.0"
-- hello --
#!/bin/sh
echo "hello under $(node -v)"
-- mine --
#!/bin/sh
echo "my own greet"
