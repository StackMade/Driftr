# which -v traces every file the resolver reads, nearest first, so users see why a pin won.

exec driftr setup
exec driftr install node@22
exec driftr default node@$NODE_VERSION

cd $WORK/app/sub
exec driftr which node -v
stdout 'Checking: .*[/\\]app[/\\]sub[/\\]\.driftr\.toml'
stdout 'Checking: .*[/\\]app[/\\]sub[/\\]\.nvmrc'
stdout 'Checking: .*[/\\]app[/\\]sub[/\\]\.node-version'
stdout 'engines\.node = >=20'
stdout 'Source: +package.json \(engines\.node\)'

# A typo in .driftr.toml stops the shim with the file named, not a quiet global default.
cd $WORK/broken
! exec node -v
stderr 'failed to parse project config .*[/\\]broken[/\\]\.driftr\.toml'
! stdout 'v'$NODE_VERSION

-- app/package.json --
{"engines": {"node": ">=20"}}
-- app/sub/README --
placeholder so the directory exists
-- broken/.driftr.toml --
[tools
node = "22"
